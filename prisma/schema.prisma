// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid()) @map("_id")
  email      String   @unique
  password   String
  full_name  String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  photo       String?
  role        Role     @default(USER)
  is_verified Boolean  @default(false)
  language    String   @default("uz")

  orders  Order[]
  cart    Cart?
  reviews ProductReview[]
}

enum Role {
  ADMIN
  USER
}

/// Katalog tekis (bir darajali): OCO katalogida 8 ta bo'lim bor, ichki
/// kategoriya yo'q. Shuning uchun `parent_id` self-relation saqlanmaydi.
model Category {
  id String @id @default(uuid()) @map("_id")

  // Ko'p tillilik alohida ustunlarda saqlanadi: MongoDB nested maydon bo'yicha
  // indeks/sortni yaxshi ko'tarmaydi, ustun esa oddiy `@@index` bilan ishlaydi.
  name_uz String
  name_ru String
  name_en String

  description_uz String?
  description_ru String?
  description_en String?

  // Slug barcha tillar uchun yagona - SEO havolasi til almashganda o'zgarmaydi.
  slug        String   @unique
  image       String?
  icon        String?
  is_archived Boolean  @default(false)
  is_featured Boolean  @default(false)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products Product[]

  @@index([is_archived])
  @@index([is_featured, is_archived])
  @@index([sort_order])
  @@index([name_uz])
  @@index([name_ru])
  @@index([name_en])
}

/// Xarakteristika. Kalit ham, qiymat ham tarjima qilinadi ("Мощность"/"Quvvat",
/// "Медный"/"Mis"), sonli qiymatlar esa uchala tilda bir xil yoziladi.
type ProductAttribute {
  key_uz String
  key_ru String
  key_en String

  value_uz String
  value_ru String
  value_en String

  // O'lchov birligi: "Вт"/"W", "м"/"m", "м³/ч"/"m3/h" ...
  // Kalitdan ajratilgani uchun fasetlarda "Quvvat" bitta guruh bo'lib qoladi.
  unit_uz String?
  unit_ru String?
  unit_en String?
}

model Product {
  id String @id @default(uuid()) @map("_id")

  name_uz String
  name_ru String
  name_en String

  description_uz String?
  description_ru String?
  description_en String?

  slug  String   @unique
  sku   String?
  brand String?
  tags  String[] @default([])
  price       Float              @default(0)
  // Narx kelishilgan holda beriladi (katalogda narx ko'rsatilmagan tovarlar).
  // true bo'lsa: `price`/`final_price` 0 bo'ladi va mahsulot savatga/buyurtmaga tushmaydi.
  price_on_request Boolean            @default(false)
  // Aksiya narxi. Bo'sh bo'lsa - chegirma yo'q.
  discount_price   Float?
  // price/discount_price dan hosil qilinadi. Filtr va sortlash SHU maydon ustida ishlaydi.
  final_price      Float              @default(0)
  discount_percent Int                @default(0)
  stock       Int                @default(0)
  images      String[]
  is_archived Boolean            @default(false)
  // Admin qo'lda "TOP" deb belgilaydi
  is_top      Boolean            @default(false)
  // Bosh sahifadagi "Tanlangan mahsulotlar" bloki
  is_featured Boolean            @default(false)
  // Sotuvlar soni - checkout paytida oshiriladi
  sales_count Int                @default(0)
  // Ko'rishlar soni - product detail ochilganda oshiriladi
  view_count  Int                @default(0)
  rating      Float              @default(0)
  rating_count Int               @default(0)
  // Sotuv + reyting + ko'rishlardan hosil qilinadigan reyting bali.
  // "TOP mahsulotlar" ni bazada indeks bo'yicha saralash uchun saqlanadi.
  popularity_score Float         @default(0)
  attributes  ProductAttribute[]

  // --- Fiskalizatsiya (O'zbekiston OFD) ------------------------------------
  // Payme `CheckPerformTransaction` javobida chek qatorlarini shu maydonlardan
  // quradi. Bo'sh qolsa PAYME_DEFAULT_* qiymatlari ishlatiladi.
  /// MXIK / IKPU - soliq organidagi tovar klassifikatori kodi (17 xonali).
  ikpu_code    String?
  /// Qadoqlash kodi (soliq.uz dagi tovar birligi kodi).
  package_code String?
  /// QQS stavkasi foizda: 0 yoki 12.
  vat_percent  Int?
  /// O'lchov birligi klassifikatori kodi (masalan, dona uchun 241092).
  units        Int?

  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  category_id String
  category    Category @relation(fields: [category_id], references: [id])

  order_items OrderItem[]
  cart_items  CartItem[]
  reviews     ProductReview[]

  @@index([name_uz])
  @@index([name_ru])
  @@index([name_en])
  @@index([price])
  @@index([final_price])
  @@index([sku])
  @@index([brand])
  @@index([category_id, is_archived])
  @@index([is_archived])
  @@index([is_archived, final_price])
  @@index([is_archived, sales_count])
  @@index([is_archived, rating])
  @@index([is_archived, created_at])
  @@index([is_archived, is_top])
  @@index([is_archived, is_featured])
  @@index([is_archived, discount_percent])
  @@index([is_archived, popularity_score])
  @@index([is_archived, price_on_request])
  @@index([category_id, is_archived, final_price])
  @@index([category_id, is_archived, popularity_score])
}

model ProductReview {
  id                  String   @id @default(uuid()) @map("_id")
  product_id          String
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rating              Int
  comment             String?
  // Foydalanuvchi shu mahsulotni haqiqatdan sotib olganmi
  is_verified_purchase Boolean @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([product_id, user_id])
  @@index([product_id])
  @@index([user_id])
  @@index([rating])
}

model Cart {
  id         String     @id @default(uuid()) @map("_id")
  user_id    String     @unique
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      CartItem[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(uuid()) @map("_id")
  cart_id    String
  cart       Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([cart_id, product_id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id               String      @id @default(uuid()) @map("_id")
  user_id          String
  user             User        @relation(fields: [user_id], references: [id])
  items            OrderItem[]
  total_amount     Float
  status           OrderStatus @default(PENDING)
  payment          Payment?
  /// Buyurtma bo'yicha barcha Payme urinishlari (bekor qilinganlari ham).
  payme_transactions PaymeTransaction[]
  shipping_address String?
  customer_phone   String?
  customer_name    String?
  notes            String?
  payment_method   String?
  is_archived      Boolean     @default(false)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([user_id])
  @@index([user_id, is_archived])
  @@index([status])
  @@index([created_at])
}

model OrderItem {
  id                String   @id @default(uuid()) @map("_id")
  order_id          String
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id        String
  product           Product  @relation(fields: [product_id], references: [id])
  quantity          Int
  price_at_purchase Float
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([order_id])
  @@index([product_id])
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

/// Payme tranzaksiya holati (Merchant API `state`).
/// Payme raqamlarini o'zgartirib bo'lmaydi - protokolda qat'iy belgilangan.
enum PaymeState {
  /// 1 - yaratilgan, to'lov hali amalga oshmagan
  CREATED
  /// 2 - to'lov muvaffaqiyatli o'tkazilgan
  PERFORMED
  /// -1 - to'lov amalga oshmasdan bekor qilingan
  CANCELLED
  /// -2 - to'lovdan keyin bekor qilingan (qaytarish)
  CANCELLED_AFTER_PERFORM
}

model Payment {
  id       String @id @default(uuid()) @map("_id")
  order_id String @unique
  order    Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  /// So'mda. Payme bilan almashinuvda tiyinga (x100) o'giriladi.
  amount        Float
  provider      String // payme, click, cash ...
  status        PaymentStatus @default(PENDING)
  error_message String?

  // --- Payme Merchant API maydonlari ---------------------------------------
  // Bu maydonlar buyurtmaning ENG SO'NGGI Payme tranzaksiyasining nusxasi -
  // admin panel bitta so'rov bilan to'lov holatini ko'rsatishi uchun. Protokol
  // uchun haqiqiy manba `PaymeTransaction`: Payme eski tranzaksiya haqida ham
  // so'rashi mumkin, bu yerda esa faqat oxirgisi turadi.
  /// Payme tomonidagi tranzaksiya identifikatori (`params.id`).
  payme_transaction_id String?
  payme_state          PaymeState?
  /// Payme yuborgan `params.time` (epoch ms). Double 2^53 gacha aniq -
  /// epoch ms uchun yetarli, BigInt esa JSON.stringify'da xato beradi.
  payme_time           Float?
  payme_create_time    Float?
  payme_perform_time   Float?
  payme_cancel_time    Float?
  /// Bekor qilish sababi (Payme `reason` kodi).
  payme_reason         Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([provider])
  @@index([payme_state])
  @@index([payme_transaction_id])
}

/// Payme tranzaksiyalari jurnali - protokol uchun yagona haqiqat manbai.
///
/// Nega alohida kolleksiya: `Payment.order_id` unikal, ya'ni bitta buyurtmaga
/// bitta to'lov yozuvi to'g'ri keladi. Payme esa har urinish uchun YANGI
/// tranzaksiya ochadi - kartada mablag' yetmasa mijoz qaytadan uriniadi.
/// Agar bitta yozuvni qayta ishlatsak, avvalgi tranzaksiya ID'si o'chib
/// ketadi va Payme keyinroq o'sha ID bilan `CheckTransaction` yoki
/// `CancelTransaction` so'raganda "topilmadi" (-31003) qaytarardik. Sverkada
/// (`GetStatement`) ham u ko'rinmay, hisob-kitob nomutanosib bo'lardi.
///
/// Shuning uchun bu yerdagi yozuvlar hech qachon qayta ishlatilmaydi: har bir
/// `CreateTransaction` yangi hujjat qo'shadi, keyingi o'zgarish faqat holatni
/// (`state`, vaqtlar, `reason`) yangilaydi.
model PaymeTransaction {
  id String @id @default(uuid()) @map("_id")

  /// Payme tomonidagi identifikator (`params.id`). Unikal - takroriy so'rov
  /// yangi yozuv yaratmaydi, ya'ni idempotentlik shu yerda ta'minlanadi.
  transaction_id String @unique

  order_id String
  order    Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  /// So'mda. Payme bilan almashinuvda tiyinga (x100) o'giriladi.
  amount Float
  state  PaymeState
  /// Payme yuborgan bekor qilish sababi kodi.
  reason Int?

  /// Payme yuborgan `params.time` (epoch ms). Double 2^53 gacha aniq -
  /// epoch ms uchun yetarli, BigInt esa JSON.stringify'da xato beradi.
  time         Float
  /// Tranzaksiya BIZDA yaratilgan vaqt. `GetStatement` shu bo'yicha filtrlaydi.
  create_time  Float
  perform_time Float?
  cancel_time  Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([order_id])
  @@index([state])
  @@index([create_time])
}
