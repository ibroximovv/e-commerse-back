// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid()) @map("_id")
  email      String   @unique
  password   String
  full_name  String?
  phone      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  photo       String?
  role        Role     @default(USER)
  is_verified Boolean  @default(false)
  language    String   @default("uz")

  orders  Order[]
  cart    Cart?
  reviews ProductReview[]
}

enum Role {
  ADMIN
  USER
}

model Category {
  id          String   @id @default(uuid()) @map("_id")
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  is_archived Boolean  @default(false)
  is_featured Boolean  @default(false)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Self relation: unlimited nesting (Electronics -> Phones -> Smartphones)
  parent_id String?
  parent    Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryTree")

  products Product[]

  @@index([is_archived])
  @@index([parent_id])
  @@index([parent_id, is_archived])
  @@index([is_featured, is_archived])
  @@index([sort_order])
}

type ProductAttribute {
  key   String
  value String
  // O'lchov birligi: "W", "m", "m3/h", "mm", "V", "kg", "l", "bar" ...
  // Kalitdan ajratilgani uchun fasetlarda "Quvvat" bitta guruh bo'lib qoladi.
  unit  String?
}

model Product {
  id          String             @id @default(uuid()) @map("_id")
  name        String
  slug        String             @unique
  sku         String?
  description String?
  brand       String?
  tags        String[]           @default([])
  price       Float              @default(0)
  // Narx kelishilgan holda beriladi (katalogda narx ko'rsatilmagan tovarlar).
  // true bo'lsa: `price`/`final_price` 0 bo'ladi va mahsulot savatga/buyurtmaga tushmaydi.
  price_on_request Boolean            @default(false)
  // Aksiya narxi. Bo'sh bo'lsa - chegirma yo'q.
  discount_price   Float?
  // price/discount_price dan hosil qilinadi. Filtr va sortlash SHU maydon ustida ishlaydi.
  final_price      Float              @default(0)
  discount_percent Int                @default(0)
  stock       Int                @default(0)
  images      String[]
  is_archived Boolean            @default(false)
  // Admin qo'lda "TOP" deb belgilaydi
  is_top      Boolean            @default(false)
  // Bosh sahifadagi "Tanlangan mahsulotlar" bloki
  is_featured Boolean            @default(false)
  // Sotuvlar soni - checkout paytida oshiriladi
  sales_count Int                @default(0)
  // Ko'rishlar soni - product detail ochilganda oshiriladi
  view_count  Int                @default(0)
  rating      Float              @default(0)
  rating_count Int               @default(0)
  // Sotuv + reyting + ko'rishlardan hosil qilinadigan reyting bali.
  // "TOP mahsulotlar" ni bazada indeks bo'yicha saralash uchun saqlanadi.
  popularity_score Float         @default(0)
  attributes  ProductAttribute[]
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt

  category_id String
  category    Category @relation(fields: [category_id], references: [id])

  order_items OrderItem[]
  cart_items  CartItem[]
  reviews     ProductReview[]

  @@index([name])
  @@index([price])
  @@index([final_price])
  @@index([sku])
  @@index([brand])
  @@index([category_id, is_archived])
  @@index([is_archived])
  @@index([is_archived, final_price])
  @@index([is_archived, sales_count])
  @@index([is_archived, rating])
  @@index([is_archived, created_at])
  @@index([is_archived, is_top])
  @@index([is_archived, is_featured])
  @@index([is_archived, discount_percent])
  @@index([is_archived, popularity_score])
  @@index([is_archived, price_on_request])
  @@index([category_id, is_archived, final_price])
  @@index([category_id, is_archived, popularity_score])
}

model ProductReview {
  id                  String   @id @default(uuid()) @map("_id")
  product_id          String
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rating              Int
  comment             String?
  // Foydalanuvchi shu mahsulotni haqiqatdan sotib olganmi
  is_verified_purchase Boolean @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([product_id, user_id])
  @@index([product_id])
  @@index([user_id])
  @@index([rating])
}

model Cart {
  id         String     @id @default(uuid()) @map("_id")
  user_id    String     @unique
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      CartItem[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(uuid()) @map("_id")
  cart_id    String
  cart       Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([cart_id, product_id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id               String      @id @default(uuid()) @map("_id")
  user_id          String
  user             User        @relation(fields: [user_id], references: [id])
  items            OrderItem[]
  total_amount     Float
  status           OrderStatus @default(PENDING)
  payment          Payment?
  shipping_address String?
  customer_phone   String?
  customer_name    String?
  notes            String?
  payment_method   String?
  is_archived      Boolean     @default(false)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([user_id])
  @@index([user_id, is_archived])
  @@index([status])
  @@index([created_at])
}

model OrderItem {
  id                String   @id @default(uuid()) @map("_id")
  order_id          String
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id        String
  product           Product  @relation(fields: [product_id], references: [id])
  quantity          Int
  price_at_purchase Float
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([order_id])
  @@index([product_id])
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid()) @map("_id")
  order_id       String        @unique
  order          Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  amount         Float
  provider       String // Click, Payme, Stripe, etc.
  status         PaymentStatus @default(PENDING)
  transaction_id String?       @unique // Vendor transaction identifier
  error_message  String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  @@index([status])
  @@index([provider])
}
