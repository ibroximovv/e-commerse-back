DATABASE_URL="mongodb://localhost:27017/e-commerse"

PORT=3000
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Seed admin (admin panelga kirish: telefon + parol)
SEED_ADMIN_PHONE="+998900000000"
SEED_ADMIN_PASSWORD="change-me-now"

UPLOAD_PATH="./uploads"

# ===========================================================================
# Payme (Merchant API)
# ===========================================================================
# Kabinet: https://test.paycom.uz (test) / https://merchant.paycom.uz (prod)
#
# Kabinetda "Кассы -> <kassa> -> Настройки" bo'limida webhook manzilini
# ko'rsating:  https://<domeningiz>/api/payments/payme
#
# --- ALMASHTIRISH SHART -----------------------------------------------------

# Kabinetdagi biznes (kassa) identifikatori, 24 belgili hex
PAYME_MERCHANT_ID="000000000000000000000000"

# Kabinetdagi "Ключ" (maxfiy kalit). Test kalitini PROD'da ISHLATMANG.
# Payme har so'rovda `Authorization: Basic base64("Paycom:<KEY>")` yuboradi.
PAYME_KEY="your_payme_secret_key"

# --- ODATDA O'ZGARTIRILMAYDI ------------------------------------------------

# Kassa oynasi: test uchun test.paycom.uz, prod uchun checkout.paycom.uz
PAYME_CHECKOUT_URL="https://test.paycom.uz"

# Kabinetdagi "account" maydonining nomi. Buyurtma ID shu nom bilan keladi.
# Kabinetda boshqacha nomlagan bo'lsangiz (masalan `order`), shuni yozing.
PAYME_ACCOUNT_FIELD="order_id"

# To'lovdan keyin mijoz qaytariladigan sahifa (checkout havolasidagi `c=`).
# Bo'sh qoldirilsa havolaga qo'shilmaydi.
PAYME_RETURN_URL="https://ocomarket.uz/orders"

# --- FISKALIZATSIYA (O'zbekiston OFD) ---------------------------------------
# Bu yerda HECH NARSA yo'q - ataylab.
#
# IKPU/MXIK tovar GURUHIGA beriladi, butun do'konga emas. Ilgari bu yerda
# PAYME_DEFAULT_* zaxirasi bor edi va u butun katalogga qo'llanardi: ya'ni
# stabilizator ham, payvandlash apparati ham "nasos" deb fiskallashardi.
#
# Endi qiymatlar BAZADA:
#   - asosiy joyi  -> Category (`ikpu_code`, `package_code`, `vat_percent`, `units`)
#                     bitta kategoriyani to'ldirsangiz ichidagi hamma mahsulot oladi;
#   - istisnolar   -> Product da xuddi shu maydonlar, kategoriyanikini qoplaydi
#                     (masalan "Asboblar" da payvandlash apparati va elektrodvigatel).
#
# Kodlarni tasnif.soliq.uz dan oling, buxgalter tasdiqlasin.
# To'ldirish qo'llanmasi: prisma/catalog/IKPU.md
# Tekshirish:             npm run db:check:ikpu
