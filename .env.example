DATABASE_URL="mongodb://localhost:27017/e-commerse"

PORT=3000
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Gmail (nodemailer, service: 'gmail') - only an app password is needed, no SMTP host/port.
# MAIL_PASS = 16-character Google App Password (https://myaccount.google.com/apppasswords),
# NOT the account password. 2-Step Verification must be enabled first.
MAIL_USER="your.address@gmail.com"
MAIL_PASS="xxxx xxxx xxxx xxxx"

# OTP settings
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

UPLOAD_PATH="./uploads"

# ===========================================================================
# Payme (Merchant API)
# ===========================================================================
# Kabinet: https://test.paycom.uz (test) / https://merchant.paycom.uz (prod)
#
# Kabinetda "Кассы -> <kassa> -> Настройки" bo'limida webhook manzilini
# ko'rsating:  https://<domeningiz>/api/payments/payme
#
# --- ALMASHTIRISH SHART -----------------------------------------------------

# Kabinetdagi biznes (kassa) identifikatori, 24 belgili hex
PAYME_MERCHANT_ID="000000000000000000000000"

# Kabinetdagi "Ключ" (maxfiy kalit). Test kalitini PROD'da ISHLATMANG.
# Payme har so'rovda `Authorization: Basic base64("Paycom:<KEY>")` yuboradi.
PAYME_KEY="your_payme_secret_key"

# --- ODATDA O'ZGARTIRILMAYDI ------------------------------------------------

# Kassa oynasi: test uchun test.paycom.uz, prod uchun checkout.paycom.uz
PAYME_CHECKOUT_URL="https://test.paycom.uz"

# Kabinetdagi "account" maydonining nomi. Buyurtma ID shu nom bilan keladi.
# Kabinetda boshqacha nomlagan bo'lsangiz (masalan `order`), shuni yozing.
PAYME_ACCOUNT_FIELD="order_id"

# To'lovdan keyin mijoz qaytariladigan sahifa (checkout havolasidagi `c=`).
# Bo'sh qoldirilsa havolaga qo'shilmaydi.
PAYME_RETURN_URL="https://oco.uz/orders"

# --- FISKALIZATSIYA (O'zbekiston OFD) ---------------------------------------
# Payme chekni soliq organiga shu ma'lumotlar bilan uzatadi. Har bir mahsulotga
# admin panel orqali alohida qiymat berish mumkin (`ikpu_code`, `package_code`,
# `vat_percent`, `units`); bu yerdagilar faqat ZAXIRA (mahsulotda bo'sh bo'lsa).
#
# Kodlarni soliq.uz / tasnif.soliq.uz dan o'z tovar guruhingiz uchun oling.

# MXIK / IKPU - tovar klassifikatori kodi (17 xonali).
# Namuna qiymat suv nasoslari guruhi uchun - O'ZINGIZNIKI bilan almashtiring.
PAYME_DEFAULT_IKPU_CODE="00702001001000000"

# Qadoqlash kodi (tasnif.soliq.uz da IKPU tanlangach chiqadi)
PAYME_DEFAULT_PACKAGE_CODE="1508957"

# QQS stavkasi foizda: 0 (QQS to'lovchisi emassiz) yoki 12
PAYME_DEFAULT_VAT_PERCENT=12

# O'lchov birligi kodi: dona = 241092
PAYME_DEFAULT_UNITS=241092
